
{% assign block_settings = block.settings %}
<div
  class="
    footer-utilities__group-back-to-top
    custom-typography
    {% if block_settings.font_size != "" %}custom-font-size{% endif %}
  "
  style="
    {% render 'typography-style', preset: 'custom', settings: block_settings %}
    {% if block_settings.text_color != blank %}--color-utilities: {{ block_settings.text_color }};{% endif %}
  "
  {{ block.shopify_attributes }}
>
  <a href="#" class="footer-utilities__text" data-back-to-top>{{ block_settings.label }}</a>
</div>

<script>
  /* The page scrolls inside .page-wrapper, so a bare "#" link does not reach the top */
  if (!window.__backToTopBound) {
    window.__backToTopBound = true;
    document.addEventListener('click', (event) => {
      const link = event.target.closest('[data-back-to-top]');
      if (!link) return;
      event.preventDefault();
      const scroller = document.querySelector('.page-wrapper') || window;
      scroller.scrollTo({ top: 0, behavior: 'smooth' });
    });
  }
</script>

{% stylesheet %}
  .footer-utilities__group-back-to-top {
    color: var(--color-utilities, var(--color-foreground-muted));
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Back to top",
  "tag": null,
  "settings": [
    {
      "type": "text",
      "id": "label",
      "label": "Label",
      "default": "Volver arriba"
    },
    {
      "type": "header",
      "content": "t:content.appearance"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "t:settings.text_color",
      "placeholder": "t:settings.default"
    },
    {
      "type": "select",
      "id": "font_size",
      "label": "t:settings.size",
      "options": [
        { "value": "0.625rem", "label": "10px" },
        { "value": "0.75rem", "label": "12px" },
        { "value": "0.875rem", "label": "14px" },
        { "value": "1rem", "label": "16px" },
        { "value": "1.125rem", "label": "18px" }
      ],
      "default": "0.75rem"
    },
    {
      "type": "select",
      "id": "case",
      "label": "t:settings.case",
      "options": [
        { "value": "none", "label": "t:options.default" },
        { "value": "uppercase", "label": "t:options.uppercase" }
      ],
      "default": "none"
    }
  ]
}
{% endschema %}
