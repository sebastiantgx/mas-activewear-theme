

{% liquid
  if section.settings.background_color != blank
    render 'contrast-override', background_color: section.settings.background_color, section_id: section.id
  endif
%}

<div
  class="section-background{% if section.settings.background_color != blank %} color-custom-{{ section.id }}{% endif %}"
></div>
<div
  class="section section--{{ section.settings.section_width }}{% if section.settings.background_color != blank %} color-custom-{{ section.id }}{% endif %}"
>
  {% liquid
    assign total_blocks = section.blocks.size

    # Grid layout calculations
    assign grid_columns = total_blocks | at_most: 4

    # Calculate last row counts using modulo arithmetic
    # last_row_count = (total_blocks - 1) % N + 1
    assign last_row_count = total_blocks | minus: 1 | modulo: 4 | plus: 1
    assign tablet_last_row_count = total_blocks | minus: 1 | modulo: 2 | plus: 1

    # Check if there are orphaned elements (single item in last row)
    assign has_isolated_grid_item_desktop = false
    assign has_isolated_grid_item_tablet = false

    if total_blocks > 4 and last_row_count == 1
      assign has_isolated_grid_item_desktop = true
    endif

    if total_blocks == 5
      assign has_isolated_grid_item_tablet = true
    endif
  %}
  <div
    class="
      footer-content
      spacing-style
      {% if has_isolated_grid_item_desktop %}footer-content--isolated-grid-item-desktop{% endif %}
      {% if has_isolated_grid_item_tablet %}footer-content--isolated-grid-item-tablet{% endif %}
    "
    style="
      {%  render 'spacing-style', settings: section.settings %}
      --footer-gap: {{ section.settings.gap }}px;
      --grid-columns: {{ grid_columns }};
      --last-row-count: {{ last_row_count }};
      --tablet-last-row-count: {{ tablet_last_row_count }};
    "
  >
    {% content_for 'blocks' %}
  </div>
</div>

{% stylesheet %}
  .footer-content {
    contain: content;
    content-visibility: auto;
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--footer-gap);
    align-items: start;
  }

  /* A group set to fill height spans the whole row so its content can sit top and bottom */
  .footer-content > .group-block--height-fill {
    align-self: stretch;
  }

  .footer-content .menu__heading__default {
    font-weight: var(--font-heading--weight);
  }

  /* Menu type presets stop at 14px for headings and links, so the footer menu is sized here to match the larger footer copy */
  .footer-content .menu__heading,
  .footer-content .menu__item,
  .footer-content .menu a {
    font-size: 1.125rem;
  }

  /* The menu heading carries tap padding for the mobile accordion; drop it where columns sit side by side so headings start level */
  @media screen and (min-width: 750px) {
    .footer-content .menu__heading {
      padding-block-start: 0;
    }
  }

  /* The logo is a JPG with a white background: multiply it onto the footer color so no white box shows */
  .footer-content .logo-block__image-wrapper {
    background-color: var(--color-background);
  }

  .footer-content .logo-block__image {
    mix-blend-mode: multiply;
  }

  .footer-content a:hover {
    text-decoration: underline;
    text-decoration-color: var(--color-foreground);
    text-decoration-thickness: 2px;
    text-underline-offset: 0.25em;
  }

  @media screen and (min-width: 750px) and (max-width: 989px) {
    .footer-content {
      grid-template-columns: repeat(min(var(--grid-columns), 3), minmax(0, 1fr));
      grid-auto-flow: row;
    }

    .footer-content[style*='--grid-columns: 4'] {
      grid-template-columns: repeat(2, 1fr);
    }

    .footer-content--isolated-grid-item-tablet > :last-child {
      grid-column: 1 / -1;
    }
  }

  @media screen and (min-width: 990px) {
    .footer-content {
      grid-template-columns: repeat(var(--grid-columns), minmax(0, 1fr));
    }

    /* Single item centered */
    .footer-content[style*='--grid-columns: 1'] {
      justify-items: center;
    }

    .footer-content--isolated-grid-item-desktop > :last-child {
      grid-column: 1 / -1;
    }
  }

  /* Stacked on small screens: center the logo, copy and menu */
  @media screen and (max-width: 749px) {
    .footer-content {
      text-align: center;
      justify-items: center;
    }

    .footer-content .group-block .group-block-content {
      align-items: center;
    }

    /* Text blocks carry their own left/right alignment; on small screens they all center */
    .footer-content .text-block,
    .footer-content .text-block > * {
      text-align: center !important;
    }

    .footer-content .menu,
    .footer-content .menu a,
    .footer-content .menu__heading {
      text-align: center;
    }

    /* The brand subtitle stays on one line: 14px where it fits, shrinking with the viewport on narrow phones */
    .footer-content .group-block .group-block .text-block:last-child,
    .footer-content .group-block .group-block .text-block:last-child > * {
      font-size: min(0.875rem, 3.4vw);
    }

    .footer-content .menu__heading,
    .footer-content .menu__item {
      justify-content: center;
    }
  }

  /* Side by side: line up the visible tops of the logo, Explorar and the shipping text.
     The logo JPG carries blank space above the wordmark and the shipping paragraph sits lower than the menu heading. */
  @media screen and (min-width: 750px) {
    .footer-content[style*='--grid-columns: 3'] > :first-child .logo-block {
      margin-block-start: -18px;
    }

    .footer-content[style*='--grid-columns: 3'] > :last-child .text-block {
      margin-block-start: -3px;
    }
  }

  /* Three columns: size to content and spread edge to edge */
  @media screen and (min-width: 750px) {
    .footer-content[style*='--grid-columns: 3'] {
      grid-template-columns: repeat(3, auto);
      justify-content: space-between;
    }
  }

  /* Touch: menu links get a 44px-tall tap area. The nav clips vertically, so the area is the link's own box (no pseudo-element)
     and the rows grow from 37px to 44px; the text itself keeps its size. */
  @media (pointer: coarse) {
    .footer-content .menu__item a {
      display: inline-flex;
      align-items: center;
      min-height: 44px;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:names.footer",
  "class": "section-wrapper",
  "blocks": [
    {
      "type": "_divider"
    },
    {
      "type": "@app"
    },
    {
      "type": "button"
    },
    {
      "type": "follow-on-shop"
    },
    {
      "type": "group"
    },
    {
      "type": "icon"
    },
    {
      "type": "image"
    },
    {
      "type": "menu"
    },
    {
      "type": "payment-icons"
    },
    {
      "type": "text"
    },
    {
      "type": "logo"
    },
    {
      "type": "jumbo-text"
    },
    {
      "type": "social-links"
    },
    {
      "type": "email-signup"
    }
  ],
  "enabled_on": {
    "groups": ["footer"]
  },
  "settings": [
    {
      "type": "select",
      "id": "section_width",
      "label": "t:settings.width",
      "options": [
        {
          "value": "page-width",
          "label": "t:options.page"
        },
        {
          "value": "full-width",
          "label": "t:options.full"
        }
      ],
      "default": "page-width"
    },
    {
      "type": "range",
      "id": "gap",
      "label": "t:settings.gap",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "t:settings.background_color",
      "default": "{{ settings.color_palette.foreground }}"
    },
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 20
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 20
    }
  ],
  "presets": [
    {
      "name": "t:names.footer",
      "category": "t:categories.footer",
      "settings": {
        "gap": 20,
        "padding-block-start": 36,
        "padding-block-end": 36
      },
      "blocks": {
        "newsletter-group": {
          "type": "group",
          "settings": {
            "content_direction": "column",
            "vertical_on_mobile": true,
            "horizontal_alignment": "flex-start",
            "vertical_alignment": "center",
            "gap": 6,
            "width": "fill"
          },
          "blocks": {
            "newsletter-heading": {
              "type": "text",
              "settings": {
                "text": "t:html_defaults.join_our_email_list",
                "width": "100%",
                "alignment": "left",
                "type_preset": "h3"
              }
            },
            "newsletter-text": {
              "type": "text",
              "settings": {
                "text": "t:html_defaults.get_exclusive_deals_and_early_access_to_new_products",
                "width": "100%",
                "alignment": "left",
                "type_preset": "rte"
              }
            }
          },
          "block_order": ["newsletter-heading", "newsletter-text"]
        },
        "newsletter-form": {
          "type": "email-signup",
          "settings": {
            "width": "fill"
          }
        }
      },
      "block_order": ["newsletter-group", "newsletter-form"]
    }
  ]
}
{% endschema %}
